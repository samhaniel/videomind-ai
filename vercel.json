{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/settings", "destination": "/settings.html" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
