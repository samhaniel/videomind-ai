# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-me-in-production

# Firebase Configuration (Optional - falls back to LocalStorage if empty)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- YouTube transcript proxy (REQUIRED for Vercel / any cloud deployment) ---
# YouTube blocks most requests coming from cloud-provider IP ranges (AWS, GCP, Azure,
# and therefore Vercel's serverless functions). Without a proxy, transcript fetches that
# work fine on localhost will fail on Vercel with RequestBlocked / IpBlocked errors.
# Sign up at https://www.webshare.io/ (buy a "Residential" proxy plan, NOT "Proxy Server"
# or "Static Residential") and set these two values in your Vercel Project's Environment
# Variables. Leave both empty for local development where your home IP works fine.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Alternative: a single generic http(s) proxy URL, e.g. http://user:pass@host:port
# Only used if the Webshare vars above are not set.
GENERIC_PROXY_URL=
